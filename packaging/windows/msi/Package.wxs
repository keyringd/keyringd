<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
      Name="Keyringd"
      Manufacturer="Keyringd maintainers"
      Version="$(MsiVersion)"
      ProductCode="$(MsiProductCode)"
      Language="1033"
      Scope="perUser"
      UpgradeCode="585AEDBA-42BB-4D0A-9E3E-841C1291C3B2">

    <SummaryInformation Description="Hardware-backed SSH keys authorized by passkeys" />
    <MajorUpgrade
        Schedule="afterInstallExecute"
        DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="KeyringdIcon" SourceFile="$(IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="KeyringdIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/keyringd/keyringd" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Keyringd" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <util:CloseApplication
        Id="CloseKeyringd"
        Target="keyringd.exe"
        Description="Close Keyringd to continue setup."
        PromptToContinue="yes"
        CloseMessage="yes"
        RebootPrompt="no" />

    <StandardDirectory Id="PerUserProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="keyringd">
        <Component Id="KeyringdExecutable" Guid="1A745E86-E7C0-41E4-8F9E-7FE4C34C2782">
          <File Id="KeyringdExe" Source="$(RuntimeDirectory)\keyringd.exe" />
          <RemoveFolder Id="RemoveKeyringdInstallFolder" On="uninstall" />
          <RegistryValue
              Root="HKCU"
              Key="Software\keyringd\Installer"
              Name="Installed"
              Type="integer"
              Value="1"
              KeyPath="yes" />
        </Component>
        <Component Id="KeyringdStartup" Guid="497109D8-ACC9-4F7E-9B63-8082C8861EA7">
          <RegistryValue
              Root="HKCU"
              Key="Software\Microsoft\Windows\CurrentVersion\Run"
              Name="keyringd"
              Type="string"
              Value="&quot;[INSTALLFOLDER]keyringd.exe&quot;"
              KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <?include $(GeneratedFiles) ?>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="KeyringdProgramMenuFolder" Name="Keyringd">
        <Component Id="KeyringdStartMenuShortcut" Guid="20CB5C28-7AD3-4BCB-8217-E63E91BE125F">
          <Shortcut
              Id="KeyringdStartMenuShortcut"
              Name="Keyringd"
              Description="Hardware-backed SSH keys authorized by passkeys"
              Target="[INSTALLFOLDER]keyringd.exe"
              WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveKeyringdProgramMenuFolder" On="uninstall" />
          <RegistryValue
              Root="HKCU"
              Key="Software\keyringd\Installer"
              Name="StartMenuShortcut"
              Type="integer"
              Value="1"
              KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Property Id="WixShellExecTarget" Value="[#KeyringdExe]" />
    <CustomAction
        Id="LaunchKeyringd"
        BinaryRef="Wix4UtilCA_X64"
        DllEntry="WixShellExec"
        Impersonate="yes" />
    <UI Id="KeyringdUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />
      <Dialog Id="KeyringdExitDialog" Width="370" Height="270" Title="!(loc.ExitDialog_Title)">
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="!(loc.WixUIFinish)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Disabled="yes" Text="!(loc.WixUICancel)" />
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="!(loc.ExitDialogBitmap)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="!(loc.WixUIBack)" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="Description" Type="Text" X="135" Y="70" Width="220" Height="40" Transparent="yes" NoPrefix="yes" Text="!(loc.ExitDialogDescription)" />
        <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="60" Transparent="yes" NoPrefix="yes" Text="!(loc.ExitDialogTitle)" />
        <Control Id="OptionalText" Type="Text" X="135" Y="110" Width="220" Height="70" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="[WIXUI_EXITDIALOGOPTIONALTEXT]" ShowCondition="WIXUI_EXITDIALOGOPTIONALTEXT AND NOT Installed" />
        <Control Id="OptionalCheckBox" Type="CheckBox" X="135" Y="196" Width="220" Height="17" Hidden="yes" Property="WIXUI_EXITDIALOGOPTIONALCHECKBOX" CheckBoxValue="1" Text="[WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT]" ShowCondition="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT AND NOT Installed" />
      </Dialog>

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="Installed AND PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="3" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
      <Publish
          Dialog="KeyringdExitDialog"
          Control="Finish"
          Event="DoAction"
          Value="LaunchKeyringd"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="KeyringdExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
      <InstallUISequence>
        <Show Dialog="KeyringdExitDialog" OnExit="success" />
      </InstallUISequence>
      <AdminUISequence>
        <Show Dialog="KeyringdExitDialog" OnExit="success" />
      </AdminUISequence>
    </UI>
    <UIRef Id="WixUI_Common" />
  </Package>
</Wix>
