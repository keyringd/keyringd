#!/bin/sh
set -eu

if [ "$#" -ne 0 ] || [ "$(/usr/bin/id -u)" -ne 0 ]; then
    exit 1
fi

# pkexec sets this to the calling user's ID after authorization.
uid=${PKEXEC_UID:-}
case "$uid" in
    ''|0|*[!0-9]*) exit 1 ;;
esac

device=/dev/tpmrm0
if [ ! -c "$device" ] || [ "$(/usr/bin/stat -c %G -- "$device")" != tss ]; then
    echo 'The TPM resource manager device is not managed by the tss group.' >&2
    exit 1
fi

account=$(/usr/bin/getent -s files passwd "$uid")
login=${account%%:*}
[ -n "$login" ]
exec /usr/sbin/usermod -a -G tss -- "$login"
